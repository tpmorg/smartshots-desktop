{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        "$DESKTOP/*",
        "$DESKTOP/**",
        "$PICTURE/Screenshots/*",
        "$PICTURE/Screenshots/**"
      ]
    },
    "opener:default",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        "https://www.smartshotsai.com/api/screenshots",
        "https://www.smartshotsai.com/api/screenshots/*"
      ]
    },
    "dialog:default",
    "notification:default",
    "deep-link:default",
    "store:default"
  ]
}
