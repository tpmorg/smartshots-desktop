{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smartshots",
  "version": "0.1.0",
  "identifier": "ai.smartshots.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "resources": []
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["smartshots"]
      }
    }
  }
}
